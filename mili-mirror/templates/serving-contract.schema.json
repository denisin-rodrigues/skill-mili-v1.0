{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nt-site-mirror/schemas/serving-contract.schema.json",
  "title": "Serving Contract",
  "type": "object",
  "required": ["host", "port", "routes", "assets", "byteRangeSupport", "spaFallback"],
  "properties": {
    "host": { "type": "string", "default": "127.0.0.1" },
    "port": { "type": "integer", "default": 4173 },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requestPath", "file", "contentType"],
        "properties": {
          "requestPath": { "type": "string" },
          "file": { "type": "string" },
          "contentType": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Mapa: caminho de requisição -> arquivo local relativo ao output_dir",
      "additionalProperties": { "type": "string" }
    },
    "querySensitiveAssets": { "type": "boolean" },
    "byteRangeSupport": { "type": "boolean" },
    "spaFallback": { "type": "boolean", "default": false },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
